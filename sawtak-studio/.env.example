# ---------- Branding ----------
APP_NAME=Sawtak Studio
APP_NAME_AR=صوتك ستوديو
PUBLIC_URL=https://your-domain.com
WHATSAPP_NUMBER=2010XXXXXXXX        # support/payment WhatsApp, international format without +

# ---------- Security ----------
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_EMAIL=you@example.com         # this email gets admin rights on signup (first user is admin too)
ALLOW_SIGNUP=true

# ---------- Engines ----------
TTS_ENGINE=elevenlabs               # elevenlabs | cairo | mock
ELEVENLABS_API_KEY=                 # from elevenlabs.io -> Profile -> API keys (cloning needs Starter+ plan)
ELEVENLABS_MODEL=eleven_multilingual_v2
LIPSYNC_ENGINE=mux                  # mux | wav2lip | latentsync
WAV2LIP_DIR=                        # /opt/Wav2Lip   (see scripts/install_local_engines.sh)
WAV2LIP_CHECKPOINT=                 # /opt/Wav2Lip/checkpoints/wav2lip_gan.pth
LATENTSYNC_DIR=                     # /opt/LatentSync
ANTHROPIC_API_KEY=                  # for script translation (console.anthropic.com)
TRANSLATE_MODEL=claude-opus-5-5

# ---------- Pricing (credits) ----------
CREDITS_PER_1000_CHARS=10
CREDITS_PER_VIDEO_SECOND=2
CREDITS_PER_VOICE_CLONE=50
MAX_UPLOAD_MB=50
WORKER_THREADS=1
